<%# The homepage's pop-up rings (sans text), turned 90° to sit in the top-right
    corner, with Jeff peeking out over the outer ring. Built in the homepage's
    orientation (rings centered on the bottom-right corner), then rotated. %>
<div class="fr-arcs" aria-hidden="true">
  <div class="fr-arcs__art">
    <div class="fr-arcs__me"><%= partial "me_vector" %></div>
    <span class="fr-arc fr-arc--outer"></span>
    <span class="fr-arc fr-arc--middle"></span>
    <span class="fr-arc fr-arc--inner"></span>
  </div>
</div>
