---
title: Happy birthday, Rebecca!
description: Messages from the people who love you.
layout: false
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta name="theme-color" content="#fffef6">
    <title><%= current_page.data.title %></title>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "for-rebecca" %>
    <script src="https://use.typekit.net/okn2nfu.js"></script>
    <script>try{Typekit.load();}catch(e){}</script>
  </head>
  <body class="fr">
    <canvas class="fr-confetti" aria-hidden="true"></canvas>
    <%= partial "rebecca_arcs" %>

    <main class="fr-app frg-app">
      <header class="frg-header">
        <p class="fr-eyebrow">With love, from your friends</p>
        <h1 class="fr-title fr-title--huge">Happy birthday, <span class="fr-highlight">Rebecca!</span></h1>
        <p class="fr-lede" data-summary>Gathering your messages…</p>
      </header>

      <div class="frg-grid" data-grid></div>
    </main>

    <%= javascript_include_tag "for-rebecca/gallery", type: "module" %>
  </body>
</html>
